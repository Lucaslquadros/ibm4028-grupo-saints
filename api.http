# Requisições prontas — extensão REST Client do VS Code
#
# A Aula 04 pede o REST Client instalado. Se ainda não tem:
#   Ctrl+Shift+X  →  procure "REST Client" (autor: Huachao Mao)  →  Install
#
# Com o servidor rodando (`uv run fastapi dev app/main.py`), aparece um
# "Send Request" acinzentado acima de cada bloco. Clique nele.
#
# A resposta abre ao lado, com o STATUS CODE no topo. É nele que você olha.

@host = http://localhost:8000
@api = {{host}}/api/v1


###############################################################################
# 1. A API está viva?
###############################################################################

### Raiz
GET {{host}}/
Accept: application/json

### Health check — é esta rota que o Azure App Service chama
# Espere: 200, com "banco": "ok"
GET {{host}}/health

### O contrato da API em JSON — é daqui que a página /docs é gerada
GET {{host}}/openapi.json


###############################################################################
# 2. Casas (RF08) — ler é seguro e idempotente, repita à vontade
###############################################################################

### Listar casas
# Espere: 200 e um objeto {total, limit, offset, items}
GET {{api}}/casas

### Paginação
GET {{api}}/casas?limit=3&offset=0

### Filtro por ativa
GET {{api}}/casas?ativa=true

### Busca parcial no nome
GET {{api}}/casas?busca=Itaim

### Detalhar uma casa
# Espere: 200
GET {{api}}/casas/1


###############################################################################
# 3. Criar casa (POST NÃO é idempotente)
###############################################################################

### Criar casa válida
# Espere: 201 Created — não 200. E repare no `id`: quem gerou foi o servidor.
POST {{api}}/casas
Content-Type: application/json

{
  "nome": "São Conrado Bar - Pinheiros",
  "marca": "São Conrado Bar",
  "cidade": "São Paulo",
  "ativa": true
}

### Mande o de cima DUAS vezes e depois liste
# Você terá duas casas iguais com ids diferentes.
GET {{api}}/casas?busca=Pinheiros


###############################################################################
# 4. Validação — quebre de propósito, um de cada vez
#    Em nenhum destes casos existe um `if` no código que faça a checagem.
###############################################################################

### nome com menos de 3 caracteres
# Espere: 422 — "String should have at least 3 characters"
POST {{api}}/casas
Content-Type: application/json

{ "nome": "AB", "marca": "Teste", "cidade": "São Paulo" }

### campo obrigatório ausente (sem `cidade`)
# Espere: 422 — "Field required", apontando o campo
POST {{api}}/casas
Content-Type: application/json

{ "nome": "Casa sem cidade", "marca": "Teste" }


###############################################################################
# 5. Não encontrado
###############################################################################

### id que não existe
# Espere: 404 — e não 200 com null. Devolver null obriga o front a adivinhar.
GET {{api}}/casas/99999

### id que nem é número
# Espere: 422. `casa_id: int` na assinatura já barrou "abc".
GET {{api}}/casas/abc


###############################################################################
# 6. Atualizar e remover
###############################################################################

### PATCH — só o campo enviado muda
# Espere: 200, com `ativa` alterada e `nome` intacto
PATCH {{api}}/casas/1
Content-Type: application/json

{ "ativa": false }

### DELETE
# Espere: 204 No Content — apagou, não há o que devolver (corpo vazio)
DELETE {{api}}/casas/1

### DELETE de novo, no mesmo id
# Espere: 404. O recurso já não existe.
DELETE {{api}}/casas/1


###############################################################################
# 7. Upload do export de custo do Everest (RF01)
###############################################################################

### Enviar um CSV de custo, associado à casa 1 e ao período 2026-09
# Espere: 201. Repare no `blob_name` da resposta: NÃO é "export.csv".
# O servidor gerou um nome novo — reusar o nome do cliente permitiria
# sobrescrever arquivo alheio e abriria path traversal.
POST {{api}}/uploads-custo
Content-Type: multipart/form-data; boundary=----limite

------limite
Content-Disposition: form-data; name="casa_id"

1
------limite
Content-Disposition: form-data; name="periodo"

2026-09
------limite
Content-Disposition: form-data; name="arquivo"; filename="export.csv"
Content-Type: text/csv

item,custo_teorico,custo_real
Grey Goose 750ml,100,120
Chopp Pilsen (barril),480,460
------limite--

### Coluna obrigatória faltando
# Espere: 422 — "Coluna(s) obrigatória(s) faltando no CSV: custo_teorico"
POST {{api}}/uploads-custo
Content-Type: multipart/form-data; boundary=----limite

------limite
Content-Disposition: form-data; name="casa_id"

1
------limite
Content-Disposition: form-data; name="periodo"

2026-09
------limite
Content-Disposition: form-data; name="arquivo"; filename="export.csv"
Content-Type: text/csv

item,custo_real
Grey Goose 750ml,120
------limite--

### Listar uploads de uma casa
GET {{api}}/uploads-custo?casa_id=1


###############################################################################
# 8. Delta custo teórico x real (RF02) — a dor nº1 do cliente
###############################################################################

### Delta da casa 1 no período 2026-09
# A soma é feita com GROUP BY/SUM no banco, não em Python.
GET {{api}}/metricas/delta?casa_id=1&periodo=2026-09

### Período sem dado carregado
# Espere: 404, com mensagem explicando o que falta — não um erro genérico.
GET {{api}}/metricas/delta?casa_id=1&periodo=2026-01
