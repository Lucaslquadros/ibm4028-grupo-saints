# Copie para .env e preencha. O .env NÃO vai para o Git.
#   cp .env.example .env          (Linux/macOS)
#   copy .env.example .env        (Windows)
#
# No Azure, estes mesmos nomes viram App Settings:
#   App Service > Configuration > Application Settings

# --- Aplicação ---------------------------------------------------------
APP_NAME="Projeto 4 API"
APP_VERSION="0.1.0"
ENVIRONMENT=local          # local | staging | production
DEBUG=true                 # SEMPRE false em produção

# --- Banco de dados ----------------------------------------------------
# Local (padrão, não precisa instalar nada):
DATABASE_URL=sqlite:///./projeto4.db

# Azure SQL (exige ODBC Driver 18 + extra `azuresql` do pyproject):
# DATABASE_URL=mssql+pyodbc://USUARIO:SENHA@SERVIDOR.database.windows.net:1433/BANCO?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# --- Azure Blob Storage ------------------------------------------------
# Vazio = uploads gravam em ./uploads_local/ (modo desenvolvimento)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads

# --- CORS --------------------------------------------------------------
# JSON. Em produção liste o domínio real do front — NUNCA ["*"]
# "null" é a origem de HTML aberto por duplo clique (file://), usada só pelo
# frontend/painel-teste.html. Remova essa entrada em produção.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","null"]

# --- Limites -----------------------------------------------------------
MAX_UPLOAD_MB=10
